{
  "entity": "Person",
  "table": "person",
  "comment": "A person known to the system -- may hold one or more course roles (student, instructor, owner) via CoursePerson.",
  "columns": [
    {
      "name": "campus_id",
      "type": "integer",
      "nullable": false,
      "primaryKey": true,
      "foreignKeys": [
        { "name": "Campus", "entity": "Campus", "column": "id", "relation": "is attended by" }
      ],
      "comment": "Campus this person belongs to."
    },
    {
      "name": "id",
      "type": "integer",
      "nullable": false,
      "primaryKey": true,
      "identity": true,
      "comment": "Surrogate identifier for the person, auto-generated by the database."
    },
    {
      "name": "uuid",
      "type": "string",
      "length": 36,
      "nullable": false,
      "unique": true,
      "comment": "Stable external identifier for the person (e.g. for APIs/integrations), independent of the internal auto-generated id.",
      "shortDescription": "External identification"
    },
    {
      "name": "first_name",
      "type": "string",
      "length": 100,
      "nullable": false,
      "comment": "Person's first name."
    },
    {
      "name": "last_name",
      "type": "string",
      "length": 100,
      "nullable": false,
      "comment": "Person's last name."
    }
  ]
}
