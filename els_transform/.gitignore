# dbt's own build output/logs — regenerated by every `dbt run`/`dbt compile`, never hand-edited.
target/
dbt_packages/
logs/

# dbt's per-user tracking file (an anonymous usage-tracking id) — machine-local, not project state.
.user.yml

# Secrets / local config — connection details belong in profiles.yml (outside this repo entirely),
# never in an .env file here, but this is kept as a backstop in case one is ever added locally.
.env
